# Terraform working directory
.terraform/

# Terraform state and crash logs
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files may contain secrets
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local Terraform CLI configuration
.terraformrc
terraform.rc
